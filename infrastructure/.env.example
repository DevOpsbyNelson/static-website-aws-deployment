# Copy to .env (gitignored) for local use. Variables already set in your shell take precedence.
# Prefixes: DEV_ (development), STAGING_ (staging), PROD_ (production).

# --- Terraform remote state (S3 backend) ---------------------------------------
# Required per environment.
DEV_REMOTE_STORAGE_AWS_S3_BUCKET=static-website-tfstate-dev
DEV_REMOTE_STORAGE_AWS_REGION=us-east-1
DEV_REMOTE_STORAGE_AWS_S3_KEY=static-website/terraform.tfstate

STAGING_REMOTE_STORAGE_AWS_S3_BUCKET=static-website-tfstate-staging
STAGING_REMOTE_STORAGE_AWS_REGION=us-east-1
STAGING_REMOTE_STORAGE_AWS_S3_KEY=static-website/terraform.tfstate

PROD_REMOTE_STORAGE_AWS_S3_BUCKET=static-website-tfstate-prod
PROD_REMOTE_STORAGE_AWS_REGION=us-east-1
PROD_REMOTE_STORAGE_AWS_S3_KEY=static-website/terraform.tfstate

# Optional: per environment (DEV_..., PROD_...) or global (no prefix).
# Leave unset to use your default AWS credentials and the real S3 endpoint.
# REMOTE_STORAGE_AWS_S3_ENDPOINT=http://localhost:4566
# REMOTE_STORAGE_AWS_ACCESS_KEY_ID=test
# REMOTE_STORAGE_AWS_SECRET_ACCESS_KEY=test

# --- Optional: local emulator only (AWS provider + AWS CLI) -------------------
# Leave unset to deploy to real AWS with your normal credentials (AWS_PROFILE, SSO, ...).
# Path-style S3 URLs are enabled automatically when AWS_ENDPOINT_URL is set.
# AWS_ENDPOINT_URL=http://localhost:4566
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# AWS_DEFAULT_REGION=us-east-1
